# Supabase 프로젝트 설정 (Dashboard > Settings > API에서 복사)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat (Dashboard > API Keys > Google Play)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-key

# ANTHROPIC_API_KEY는 여기 넣지 말 것. supabase secrets로만 관리 (클라이언트 노출 금지)
